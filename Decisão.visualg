algoritmo "Menu"

var
opcao : inteiro

inicio
escreval("1 - Hambúrguer")
escreval("2 - Pizza")
escreval("3 - Salada")
escreval("4 - Bebidas")
escreval("Pressione *0* para cancelar a operação")
leia (opcao)
escreval("Opção escolhida: ", opcao)

escolha opcao
caso 1 
escreval("Preparando Hambúrguer...")
caso 2
escreval("Assando pizza...")
caso 3
escreval("Cortando salada...")
caso 4
escreval("Pegando bebida...")
caso 0
escreval("Agradecemos o contato!")
fimescolha

fimalgoritmo